{
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": []
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "disabled": false,
      "autoApprove": [
        "new_page",
        "performance_start_trace",
        "performance_analyze_insight",
        "take_snapshot",
        "list_console_messages",
        "list_network_requests",
        "evaluate_script",
        "performance_stop_trace"
      ]
    }
  }
}